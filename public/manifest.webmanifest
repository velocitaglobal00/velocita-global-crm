{
  "name": "Velocita Global CRM",
  "short_name": "Velocita",
  "description": "CRM da Velocita Global: roteiro, pipeline, chat da equipe e notificações.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
