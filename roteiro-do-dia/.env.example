# ===== IA (preencha pelo menos UMA chave — quanto mais, mais resiliente) =====
# Opção gratuita 1 (recomendada): Google Gemini — crie a chave em https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Opção gratuita 2 (recomendada): OpenRouter — usa o roteador automático de modelos
# gratuitos (openrouter/free), então não depende de um modelo específico ficar no ar.
# Crie a chave (grátis, sem cartão) em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Opção gratuita 3 (fallback extra, se disponível): Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opção gratuita 4: Cerebras — inferência muito rápida, sem cartão.
# Crie a chave em https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Opção gratuita 5: Mistral (La Plateforme) — sem cartão para o tier gratuito.
# Crie a chave em https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Opção paga: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ===== BANCO DE DADOS =====
# Sem essas duas variáveis, o app usa um arquivo SQLite local (./data.db) — funciona,
# mas em provedores com disco não-persistente (ex: Render free) os dados somem a cada
# deploy/reinício. Para persistir de verdade, crie um banco gratuito em https://turso.tech
# (não pede cartão) e cole a URL e o token de autenticação gerados por ele aqui:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== ACESSO =====
# Código exigido no login e no registro (distribua só para o time)
ACCESS_CODE=defina-um-codigo-aqui

# Conta de administrador (criada automaticamente na primeira execução)
ADMIN_USER=admin
ADMIN_PASS=defina-uma-senha-forte

# Email exibido nos botões "Contatar administração"
CONTACT_EMAIL=velocitaglobal@gmail.com

PORT=3000
